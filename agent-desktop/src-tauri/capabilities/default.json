{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the RemoteCtrl Agent desktop windows.",
  "windows": ["main", "approval-*", "activity-indicator", "screen-indicator", "webcam-indicator"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "dialog:allow-open",
    "allow-agent-core-bridge"
  ]
}