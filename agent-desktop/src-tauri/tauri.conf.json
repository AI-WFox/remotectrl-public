{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RemoteCtrl Agent",
  "version": "0.2.0",
  "identifier": "com.remotectrl.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RemoteCtrl Agent",
        "width": 1180,
        "height": 760,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Consent-first remote support Agent",
    "longDescription": "RemoteCtrl Windows Agent for visible, consent-first remote support demos.",
    "externalBin": ["binaries/remotectrl-agent-core"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper", "silent": true } }
  }
}